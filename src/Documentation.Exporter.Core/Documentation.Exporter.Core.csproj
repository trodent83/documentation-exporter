<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Documentation.Exporter.Core</RootNamespace>
    <AssemblyName>Documentation.Exporter.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Documentation.Exporter.Cli" />
    <InternalsVisibleTo Include="Documentation.Exporter.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Documentation.Exporter.Abstractions\Documentation.Exporter.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
