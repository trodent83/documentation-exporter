# =============================================================================
# 1. Centralized, Legacy & Demo Build Outputs
# =============================================================================
# Root centralized build directory configured via <ArtifactsPath> in Directory.Build.props,
# demo export output folder (.demo-output/), and standard MSBuild fallback directories.
[Bb]uild/
.demo-output/
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/

# =============================================================================
# 2. Automated Test & Code Coverage Reports
# =============================================================================
# Output directories and report files generated by xUnit, VSTest, and Coverlet
# (including scripts/Run-CodeCoverage.ps1).
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
coverage*.info

# =============================================================================
# 3. IDE, Editor & User-Specific Workspace State
# =============================================================================
# Personal IDE preferences, caches, and local workspace settings that should not
# be shared across developer machines.
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.DotSettings.user

# =============================================================================
# 4. NuGet & MSBuild Package / Build Artifacts
# =============================================================================
# Local package archives, lock files, and binary build logs.
*.nupkg
*.snupkg
*.binlog
project.lock.json
project.assets.json

# =============================================================================
# 5. Temporary Diagnostics & Local Scratch Files
# =============================================================================
# Ephemeral log outputs, build error dumps, and temporary files.
*.tmp
*.log
*.bak
*.swp
build_errors.txt

# =============================================================================
# 6. Operating System Metadata Files
# =============================================================================
# OS-generated folder metadata and thumbnail caches across Windows, macOS, and Linux.
.DS_Store
Thumbs.db
Desktop.ini
